[
  {
    "id": "s1",
    "text": "إنما الأعمال بالنيات، وإنما لكل امرئ ما نوى",
    "url": "https://dorar.net/hadith/1",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s2",
    "text": "بني الإسلام على خمس: شهادة أن لا إله إلا الله وأن محمدا رسول الله، وإقام الصلاة...",
    "url": "https://dorar.net/hadith/2",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s3",
    "text": "لا يؤمن أحدكم حتى يحب لأخيه ما يحب لنفسه",
    "url": "https://dorar.net/hadith/3",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s4",
    "text": "الدين النصيحة. قلنا: لمن؟ قال: لله ولكتابه ولرسوله ولأئمة المسلمين وعامتهم",
    "url": "https://dorar.net/hadith/4",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s5",
    "text": "والكلمة الطيبة صدقة",
    "url": "https://dorar.net/hadith/5",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s6",
    "text": "إن الله لا ينظر إلى صوركم وأموالكم، ولكن ينظر إلى قلوبكم وأعمالكم",
    "url": "https://dorar.net/hadith/6",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s7",
    "text": "من سلك طريقا يلتمس فيه علما سهل الله له به طريقا إلى الجنة",
    "url": "https://dorar.net/hadith/7",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s8",
    "text": "تبسمك في وجه أخيك لك صدقة",
    "url": "https://dorar.net/hadith/8",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s9",
    "text": "لا ضرر ولا ضرار",
    "url": "https://dorar.net/hadith/9",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s10",
    "text": "اتقوا الظلم، فإن الظلم ظلمات يوم القيامة",
    "url": "https://dorar.net/hadith/10",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s11",
    "text": "المسلم من سلم المسلمون من لسانه ويده",
    "url": "https://dorar.net/hadith/11",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s12",
    "text": "كلكم راع وكلكم مسؤول عن رعيته",
    "url": "https://dorar.net/hadith/12",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s13",
    "text": "من رأى منكم منكرا فليغيره بيده، فإن لم يستطع فبلسانه...",
    "url": "https://dorar.net/hadith/13",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s14",
    "text": "الطهور شطر الإيمان، والحمد لله تملا الميزان",
    "url": "https://dorar.net/hadith/14",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s15",
    "text": "آية المنافق ثلاث: إذا حدث كذب، وإذا وعد أخلف، وإذا اؤتمن خان",
    "url": "https://dorar.net/hadith/15",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s16",
    "text": "خيركم من تعلم القرآن وعلمه",
    "url": "https://dorar.net/hadith/16",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s17",
    "text": "لا يدخل الجنة من كان في قلبه مثقال ذرة من كبر",
    "url": "https://dorar.net/hadith/17",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s18",
    "text": "من صام رمضان إيمانا واحتسابا غفر له ما تقدم من ذنبه",
    "url": "https://dorar.net/hadith/18",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s19",
    "text": "العمرة إلى العمرة كفارة لما بينهما، والحج المبرور ليس له جزاء إلا الجنة",
    "url": "https://dorar.net/hadith/19",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s20",
    "text": "من غشنا فليس منا",
    "url": "https://dorar.net/hadith/20",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s21",
    "text": "المرء مع من أحب يوم القيامة",
    "url": "https://dorar.net/hadith/21",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s22",
    "text": "اتقوا النار ولو بشق تمرة، فمن لم يجد فبكلمة طيبة",
    "url": "https://dorar.net/hadith/22",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s23",
    "text": "ما نقصت صدقة من مال، وما زاد الله عبدا بعفو إلا عزا",
    "url": "https://dorar.net/hadith/23",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s24",
    "text": "من دل على خير فله مثل أجر فاعله",
    "url": "https://dorar.net/hadith/24",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s25",
    "text": "المؤمن القوي خير وأحب إلى الله من المؤمن الضعيف",
    "url": "https://dorar.net/hadith/25",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s26",
    "text": "حق المسلم على المسلم خمس: رد السلام، وعيادة المريض...",
    "url": "https://dorar.net/hadith/26",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s27",
    "text": "الصيام جنة، فإذا كان يوم صوم أحدكم فلا يرفث ولا يصخب",
    "url": "https://dorar.net/hadith/27",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s28",
    "text": "من يرد الله به خيرا يفقهه في الدين",
    "url": "https://dorar.net/hadith/28",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s29",
    "text": "إنما الصبر عند الصدمة الأولى",
    "url": "https://dorar.net/hadith/29",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s30",
    "text": "ليس الشديد بالصرعة، إنما الشديد الذي يملك نفسه عند الغضب",
    "url": "https://dorar.net/hadith/30",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s31",
    "text": "اختلاف أمتي رحمة",
    "url": "https://dorar.net/fake/1",
    "ruling": "لا أصل له (موضوع)",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s32",
    "text": "من نام بعد العصر فاختلس عقله فلا يلومن إلا نفسه",
    "url": "https://dorar.net/fake/2",
    "ruling": "ضعيف جدا",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s33",
    "text": "النظافة من الإيمان",
    "url": "https://dorar.net/fake/3",
    "ruling": "موضوع",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s34",
    "text": "صوموا تصحوا",
    "url": "https://dorar.net/fake/4",
    "ruling": "ضعيف",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s35",
    "text": "من حج فلم يزرني فقد جفاني",
    "url": "https://dorar.net/fake/5",
    "ruling": "موضوع",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s36",
    "text": "لو أحسن أحدكم ظنه بحجر لنفعه",
    "url": "https://dorar.net/fake/6",
    "ruling": "موضوع",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s37",
    "text": "من عرف نفسه فقد عرف ربه",
    "url": "https://dorar.net/fake/7",
    "ruling": "لا أصل له",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s38",
    "text": "حب الوطن من الإيمان",
    "url": "https://dorar.net/fake/8",
    "ruling": "موضوع",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s39",
    "text": "المعدة بيت الداء والحمية رأس الدواء",
    "url": "https://dorar.net/fake/9",
    "ruling": "ليس بحديث (كلام أطباء)",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s40",
    "text": "أبغض الحلال إلى الله الطلاق",
    "url": "https://dorar.net/fake/10",
    "ruling": "ضعيف",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s41",
    "text": "اطلبوا العلم ولو بالصين",
    "url": "https://dorar.net/fake/11",
    "ruling": "موضوع",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s42",
    "text": "إياكم وخضراء الدمن. قيل: وما خضراء الدمن؟ قال: المرأة الحسناء في المنبت السوء",
    "url": "https://dorar.net/fake/12",
    "ruling": "ضعيف جدا",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s43",
    "text": "الجنة تحت أقدام الأمهات",
    "url": "https://dorar.net/fake/13",
    "ruling": "موضوع بهذا اللفظ",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s44",
    "text": "خير الأسماء ما حمد وعبد",
    "url": "https://dorar.net/fake/14",
    "ruling": "لا أصل له",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s45",
    "text": "الدين المعاملة",
    "url": "https://dorar.net/fake/15",
    "ruling": "لا أصل له",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s46",
    "text": "الساكت عن الحق شيطان أخرس",
    "url": "https://dorar.net/fake/16",
    "ruling": "ليس بحديث (مقولة لأبي علي الدقاق)",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s47",
    "text": "من لم يهتم بأمر المسلمين فليس منهم",
    "url": "https://dorar.net/fake/17",
    "ruling": "ضعيف",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s48",
    "text": "لا صلاة لجار المسجد إلا في المسجد",
    "url": "https://dorar.net/fake/18",
    "ruling": "ضعيف",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s49",
    "text": "الأقربون أولى بالمعروف",
    "url": "https://dorar.net/fake/19",
    "ruling": "ليس بحديث",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s50",
    "text": "من كثر ضحكه قلت هيبته",
    "url": "https://dorar.net/fake/20",
    "ruling": "ليس بحديث (من أقوال عمر بن الخطاب)",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s51",
    "text": "لا تتمارضوا فتمرضوا، ولا تحفروا قبوركم فتموتوا",
    "url": "https://dorar.net/fake/21",
    "ruling": "لا أصل له",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s52",
    "text": "الباذنجان لما أكل له",
    "url": "https://dorar.net/fake/22",
    "ruling": "موضوع",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s53",
    "text": "من قلد عالما لقي الله سالما",
    "url": "https://dorar.net/fake/23",
    "ruling": "لا أصل له",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s54",
    "text": "تفكر ساعة خير من عبادة ستين سنة",
    "url": "https://dorar.net/fake/24",
    "ruling": "موضوع",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s55",
    "text": "أنا مدينة العلم وعلي بابها",
    "url": "https://dorar.net/fake/25",
    "ruling": "موضوع",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s56",
    "text": "العمل عبادة",
    "url": "https://dorar.net/fake/26",
    "ruling": "ليس بحديث",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s57",
    "text": "البر لا يبلى، والإثم لا ينسى، والديان لا يموت، فكن كما شئت، كما تدين تدان",
    "url": "https://dorar.net/fake/27",
    "ruling": "ضعيف",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s58",
    "text": "النظافة نصف الدين",
    "url": "https://dorar.net/fake/28",
    "ruling": "موضوع",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s59",
    "text": "من تعلم لغة قوم أمن مكرهم",
    "url": "https://dorar.net/fake/29",
    "ruling": "لا أصل له",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s60",
    "text": "الضرورات تبيح المحظورات",
    "url": "https://dorar.net/fake/30",
    "ruling": "ليس بحديث بل قاعدة فقهية",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
    "id": "s61",
    "text": "إياك نعبد وإياك نستعين",
    "url": "https://quranpedia.net/surah/1/5",
    "ruling": "نص قرآني (سورة الفاتحة)",
    "source": "quranpedia.net",
    "type": "quran"
  },
  {
    "id": "s62",
    "text": "إن مع العسر يسرا",
    "url": "https://quranpedia.net/surah/94/6",
    "ruling": "نص قرآني (سورة الشرح)",
    "source": "quranpedia.net",
    "type": "quran"
  },
  {
    "id": "s63",
    "text": "قل هو الله أحد",
    "url": "https://quranpedia.net/surah/112/1",
    "ruling": "نص قرآني (سورة الإخلاص)",
    "source": "quranpedia.net",
    "type": "quran"
  },
  {
    "id": "s64",
    "text": "وقضى ربك ألا تعبدوا إلا إياه وبالوالدين إحسانا",
    "url": "https://quranpedia.net/surah/17/23",
    "ruling": "نص قرآني (سورة الإسراء)",
    "source": "quranpedia.net",
    "type": "quran"
  },
  {
    "id": "s65",
    "text": "يا أيها الذين آمنوا استعينوا بالصبر والصلاة إن الله مع الصابرين",
    "url": "https://quranpedia.net/surah/2/153",
    "ruling": "نص قرآني (سورة البقرة)",
    "source": "quranpedia.net",
    "type": "quran"
  },
  {
    "id": "s66",
    "text": "فمن يعمل مثقال ذرة خيرا يره",
    "url": "https://quranpedia.net/surah/99/7",
    "ruling": "نص قرآني (سورة الزلزلة)",
    "source": "quranpedia.net",
    "type": "quran"
  },
  {
    "id": "s67",
    "text": "وما خلقت الجن والإنس إلا ليعبدون",
    "url": "https://quranpedia.net/surah/51/56",
    "ruling": "نص قرآني (سورة الذاريات)",
    "source": "quranpedia.net",
    "type": "quran"
  },
  {
    "id": "s68",
    "text": "ولا تقربوا الزنا إنه كان فاحشة وساء سبيلا",
    "url": "https://quranpedia.net/surah/17/32",
    "ruling": "نص قرآني (سورة الإسراء)",
    "source": "quranpedia.net",
    "type": "quran"
  },
  {
    "id": "s69",
    "text": "إن الدين عند الله الإسلام",
    "url": "https://quranpedia.net/surah/3/19",
    "ruling": "نص قرآني (سورة آل عمران)",
    "source": "quranpedia.net",
    "type": "quran"
  },
  {
    "id": "s70",
    "text": "اقرأ باسم ربك الذي خلق",
    "url": "https://quranpedia.net/surah/96/1",
    "ruling": "نص قرآني (سورة العلق)",
    "source": "quranpedia.net",
    "type": "quran"
  },
  {
    "id": "s71",
    "text": "إن الله وملائكته يصلون على النبي يا أيها الذين آمنوا صلوا عليه وسلموا تسليما",
    "url": "https://quranpedia.net/surah/33/56",
    "ruling": "نص قرآني (سورة الأحزاب)",
    "source": "quranpedia.net",
    "type": "quran"
  },
  {
    "id": "s72",
    "text": "لا يكلف الله نفسا إلا وسعها لها ما كسبت وعليها ما اكتسبت",
    "url": "https://quranpedia.net/surah/2/286",
    "ruling": "نص قرآني (سورة البقرة)",
    "source": "quranpedia.net",
    "type": "quran"
  },
