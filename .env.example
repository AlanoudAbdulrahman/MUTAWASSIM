# قالب الإعدادات — انسخوا هذا الملف إلى .env (غير مرفوع) واملؤوا القيم.

# وضع التشغيل: 1 = بلا مفاتيح (حتمي، للتكامل) | 0 = النماذج الحقيقية
MOCK_MODE=1

# النموذج اللغوي (عند MOCK_MODE=0)
LLM_PROVIDER=openai
LLM_API_KEY=            # هنا في .env فقط، أو في متغيرات بيئة النظام (تتقدّم على .env)
LLM_MODEL=gpt-4o-mini

# الـ embeddings:
#   openai -> text-embedding-3-small عبر الـAPI (بلا torch، الأنسب على ويندوز)
#   local  -> sentence-transformers محليًا (يتطلب torch سليمًا)
EMBED_PROVIDER=openai
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# استخراج الادعاءات بالـLLM (اختياري). الافتراضي حتمي يحفظ النص الأصلي.
# فعّلوه (=1) للمنشورات المعقّدة متعددة الادعاءات فقط.
USE_LLM_EXTRACT=0

# الاسترجاع والعتبات
RETRIEVE_K=5
MIN_CONFIDENCE=0.35
MIN_SIM=0.15          # عتبة التشابه الدلالي (local)
MIN_SIM_OPENAI=0.45   # عتبة التشابه الدلالي (openai)
MIN_COVERAGE=0.6      # عتبة التطابق اللفظي (الهجين/MOCK)

# حماية الموقع (api/security.py) — كل تحقق يستدعي نموذجًا مدفوعًا
MAX_POSTS=50              # أقصى عدد منشورات في الدفعة الواحدة
MAX_POST_CHARS=4000       # أقصى طول للمنشور
ADMIN_TOKEN=              # إن ضُبط: تشغيل القياس يتطلب الترويسة X-Admin-Token. فارغ = من جهاز الخادم فقط
EXPOSE_DOCS=1             # 0 = إخفاء /docs عند النشر العام
AUTO_EVALUATE=1          # 1 = يُعاد قياس الأداء تلقائيًا عند تغيّر الكود/البيانات (بتكلفة بسيطة)
COOKIE_SECURE=auto        # auto = كوكي Secure عند HTTPS
SERVER_KEY_FOR=local      # من يستخدم LLM_API_KEY: local = جهاز الخادم فقط (زوار الإنترنت بمفاتيحهم) · none · all
TRUST_LOCALHOST=1         # 0 عند النشر خلف وسيط عكسي (يظهر كل الزوار كـ 127.0.0.1)
