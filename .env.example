# انسخوا هذا الملف إلى .env (غير مرفوع) واملؤوا القيم عند تفعيل الوضع الحقيقي

MOCK_MODE=1                 # 1 = تشغيل بلا مفاتيح (افتراضي). 0 = النماذج الحقيقية

LLM_PROVIDER=openai
LLM_API_KEY=                # ضعوا المفتاح هنا في .env فقط
LLM_MODEL=gpt-4o-mini

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

RETRIEVE_K=5
MIN_CONFIDENCE=0.35
MIN_SIM=0.15
