# قالب الإعدادات — انسخوا هذا الملف إلى .env (غير مرفوع) واملؤوا القيم.

# وضع التشغيل: 1 = بلا مفاتيح (حتمي، للتكامل) | 0 = النماذج الحقيقية
MOCK_MODE=1

# النموذج اللغوي (عند MOCK_MODE=0)
LLM_PROVIDER=openai
LLM_API_KEY=            # هنا في .env فقط، أو في متغيرات بيئة النظام (تتقدّم على .env)
LLM_MODEL=gpt-4o-mini

# الـ embeddings:
#   openai -> text-embedding-3-small عبر الـAPI (بلا torch، الأنسب على ويندوز)
#   local  -> sentence-transformers محليًا (يتطلب torch سليمًا)
EMBED_PROVIDER=openai
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# استخراج الادعاءات بالـLLM (اختياري). الافتراضي حتمي يحفظ النص الأصلي.
# فعّلوه (=1) للمنشورات المعقّدة متعددة الادعاءات فقط.
USE_LLM_EXTRACT=0

# الاسترجاع والعتبات
RETRIEVE_K=5
MIN_CONFIDENCE=0.35
MIN_SIM=0.15          # عتبة التشابه الدلالي (local)
MIN_SIM_OPENAI=0.45   # عتبة التشابه الدلالي (openai)
MIN_COVERAGE=0.6      # عتبة التطابق اللفظي (الهجين/MOCK)
