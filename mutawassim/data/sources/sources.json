    "url": "https://dorar.net/hadith/search?q=%D8%A8%D9%86%D9%8A%20%D8%A7%D9%84%D8%A5%D8%B3%D9%84%D8%A7%D9%85%20%D8%B9%D9%84%D9%89%20%D8%AE%D9%85%D8%B3%3A%20%D8%B4%D9%87%D8%A7%D8%AF%D8%A9%20%D8%A3%D9%86%20%D9%84%D8%A7",
    "ruling": "صحيح",
    "source": "dorar.net/hadith",
    "type": "hadith"
  },
  {
